# GEMINI_API_KEY: Required for Gemini AI assisted menu photo extraction.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Permanent URL of the deployed application (used for generating print QR codes).
# AI Studio injects this at runtime with the Cloud Run service URL.
APP_URL="https://ais-dev-5ljgi7iftlfvkcmjl7wwkm-26547333946.asia-southeast1.run.app"

# SUPABASE_URL & ANON_KEY: Connect your Supabase PostgreSQL cloud database.
# Find these in your Supabase Dashboard -> Project Settings -> API.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# SUPABASE_SERVICE_ROLE_KEY: Optional backend privileged key for server-side order validation.
SUPABASE_SERVICE_ROLE_KEY=""
